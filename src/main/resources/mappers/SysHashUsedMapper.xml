<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fzm.mall.mapper.SysHashUsedMapper">

    <insert id="insert">
        insert into sys_hash_used(tx_hash, create_time)
        values (#{txHash}, #{createTime})
    </insert>

    <select id="getByTxHash" resultType="java.lang.String">
        select tx_hash
        from sys_hash_used
        where tx_hash = #{txHash}
    </select>
</mapper>