<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fzm.mall.mapper.ChainContractMapper">
    <insert id="insert">
        insert into chain_contract(ct_id, type, name, address)
        VALUES (#{ctId}, #{type}, #{name}, #{address})
    </insert>

    <select id="getByCtId" resultType="com.fzm.mall.entity.dataobject.ChainContractDO">
        select *
        from chain_contract
        where ct_id = #{ctId}
    </select>

    <select id="list" resultType="com.fzm.mall.entity.dataobject.ChainContractDO">
        select *
        from chain_contract
    </select>
</mapper>